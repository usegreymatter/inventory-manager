{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Stock Runway canonical common types",
  "description": "Shared scalar rules. Mirrors docs/data/CONTRACT.md v1.0 limits: identifiers are case-sensitive and never trimmed; blank/absent means unknown, explicit 0 means measured none.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.{0,126}\\S)?$",
      "description": "Stable source identifier. No surrounding whitespace. Never a display name."
    },
    "sku": {
      "$ref": "#/$defs/id"
    },
    "warehouse": {
      "$ref": "#/$defs/id"
    },
    "text": {
      "type": "string",
      "maxLength": 500,
      "description": "Display text. Data, never HTML or a formula."
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "Base-unit quantity, finite, non-negative."
    },
    "positive_quantity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000000.0
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "Per base unit, in the envelope currency."
    },
    "lead_days": {
      "type": "number",
      "minimum": 0,
      "maximum": 3650
    },
    "date": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Local business date YYYY-MM-DD."
    },
    "datetime": {
      "type": "string",
      "maxLength": 40,
      "description": "RFC 3339 timestamp with offset, e.g. 2026-11-17T09:00:00+03:00."
    },
    "month": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}-(0[1-9]|1[0-2])$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{0,5}[1-9])?$",
      "description": "Canonical decimal text (no exponent, no trailing zeros) for signed/hashed payloads, per ORDER-BUILDING-SPEC 6.1."
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 40
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "record_id": {
          "type": "string",
          "maxLength": 128
        },
        "updated_at": {
          "$ref": "#/$defs/datetime"
        }
      },
      "description": "Where the record came from. Used for incremental sync and idempotency; never shown as truth."
    }
  }
}
