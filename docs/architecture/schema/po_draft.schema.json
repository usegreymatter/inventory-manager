{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "po_draft.schema.json",
  "title": "po_draft",
  "description": "A purchase-order draft prepared locally from a proposal. Quantities are canonical decimal strings so the payload can be hashed/MACed (ORDER-BUILDING-SPEC 6.1). A draft is not an order until a human (or L3 within guardrails) sends it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "supplier_id",
    "currency",
    "snapshot_date",
    "planning_date",
    "lines",
    "proposal_digest",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "supplier_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/currency"
    },
    "snapshot_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "planning_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "deliver_to": {
      "$ref": "common.schema.json#/$defs/warehouse"
    },
    "requested_delivery_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "quantity",
          "unit"
        ],
        "properties": {
          "sku": {
            "$ref": "common.schema.json#/$defs/sku"
          },
          "supplier_sku": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "quantity": {
            "$ref": "common.schema.json#/$defs/decimal_string"
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "unit_cost": {
            "$ref": "common.schema.json#/$defs/decimal_string"
          },
          "forecast_cover_qty": {
            "$ref": "common.schema.json#/$defs/decimal_string",
            "description": "Forecast demand over the cover window; used by the max-qty guardrail."
          },
          "flags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "enum": [
                "big_order",
                "first_order_to_supplier",
                "price_changed",
                "manual_edit",
                "lead_time_unknown"
              ]
            }
          }
        }
      }
    },
    "total_value": {
      "$ref": "common.schema.json#/$defs/decimal_string"
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "drafted",
        "pending_approval",
        "approved",
        "scheduled",
        "sent",
        "cancelled",
        "failed",
        "expired"
      ]
    },
    "autonomy_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
